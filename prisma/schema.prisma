generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @map("_id")
  username String @unique
}

model Announcement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  classId     String   @db.ObjectId
  date        DateTime @db.Date
  description String
  title       String
}

model Assignment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  dueDate   DateTime @db.Date
  lessonId  String   @db.ObjectId
  startDate DateTime @db.Date
  title     String
}

model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  date      DateTime @db.Date
  lessonId  String   @db.ObjectId
  present   Boolean
  studentId String   @db.ObjectId
}

model Class {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  capacity     BigInt
  gradeId      String @db.ObjectId
  name         String @unique
  supervisorId String @db.ObjectId
}

model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  classId     String   @db.ObjectId
  description String
  endTime     DateTime @db.Date
  startTime   DateTime @db.Date
  title       String
}

model Exam {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endTime   DateTime @db.Date
  lessonId  String   @db.ObjectId
  startTime DateTime @db.Date
  title     String
}

model Grade {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  level BigInt @unique
}

model Lesson {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  classId   String   @db.ObjectId
  day       String
  endTime   DateTime @db.Date
  name      String
  startTime DateTime @db.Date
  subjectId String   @db.ObjectId
  teacherId String   @db.ObjectId
}

model Parent {
  id        String   @id @map("_id")
  address   String
  createdAt DateTime @db.Date
  email     String   @unique
  name      String
  phone     String   @unique
  surname   String
  username  String   @unique
}

model Result {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  assignmentId String? @db.ObjectId
  examId       String? @db.ObjectId
  score        BigInt
  studentId    String  @db.ObjectId
}

model Student {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  address   String
  birthday  DateTime @db.Date
  bloodType String
  classId   String   @db.ObjectId
  createdAt DateTime @db.Date
  email     String   @unique
  gradeId   String   @db.ObjectId
  name      String
  parentId  String
  phone     String   @unique
  sex       String
  surname   String
  username  String   @unique
}

model Subject {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  teacherId String[]
}

model Teacher {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  address   String
  birthday  DateTime @db.Date
  bloodType String
  createdAt DateTime @db.Date
  email     String   @unique
  name      String
  phone     String   @unique
  sex       String
  subjectId String[]
  surname   String
  username  String   @unique
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}